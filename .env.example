# Backend
DATABASE_URL=postgres://zzpeo:zzpeo@localhost:5432/zzpeo?sslmode=disable
APP_SECRET_KEY=<generate with: openssl rand -hex 32>
API_PORT=8080

# Auth — initial admin seeded on first startup if no admin exists
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Frontend base URL — used to generate registration links
APP_URL=http://localhost:3000

# Frontend proxy — Next.js rewrites /api/v1/* to this backend URL (server-side only)
API_URL=http://localhost:8080
# Set NEXT_PUBLIC_API_URL only to bypass the proxy (e.g. direct API access)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Production DB (override for prod)
POSTGRES_USER=zzpeo
POSTGRES_PASSWORD=zzpeo
POSTGRES_DB=zzpeo
